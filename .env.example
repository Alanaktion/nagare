# Nagare runs with just PHP and SQLite using the defaults below: no queue
# worker, WebSocket server or search service. The recommended stack (PostgreSQL,
# Reverb, Typesense and Valkey) is set up by the commented "Recommended stack"
# values further down; see README.md.
APP_NAME=Nagare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Recommended stack: PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=nagare
# DB_USERNAME=nagare
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime updates need Reverb (see below). Without it, set the broadcaster to
# null and changes from other people appear when a page is next loaded.
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

# Issue attachments are stored on a private disk and only served to people who
# can see the issue. Use `s3` (or another S3-compatible disk configured in
# config/filesystems.php, which needs league/flysystem-aws-s3-v3) to keep them
# off the server. Files larger than the limit (in KB) are refused, so keep it
# within PHP's upload_max_filesize and post_max_size and your proxy's body size.
ATTACHMENTS_DISK=local
ATTACHMENTS_MAX_SIZE_KB=10240
# Deleted attachments are kept this many days before attachments:prune removes the files
ATTACHMENTS_PRUNE_AFTER_DAYS=30

# `sync` runs queued work inside the request, so no worker is needed. For the
# recommended stack use `redis` (Valkey) and run `php artisan queue:work`.
QUEUE_CONNECTION=sync

# Search runs against the database by default.
# Recommended stack: Typesense. Also set SCOUT_QUEUE=true when a queue worker
# runs, then run `php artisan scout:import "App\Models\Issue"` and the same
# for Board. Meilisearch is configured in config/scout.php but needs its PHP client.
SCOUT_DRIVER=database
SCOUT_QUEUE=false
SCOUT_PREFIX=
# SCOUT_DRIVER=typesense
# TYPESENSE_HOST=127.0.0.1
# TYPESENSE_PORT=8108
# TYPESENSE_PROTOCOL=http
# TYPESENSE_API_KEY=
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Recommended stack: Valkey (or Redis) for queues, through the phpredis extension
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Require new users to verify their email address (needs working mail)
AUTH_VERIFY_EMAIL=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@phproject.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Reverse proxies to trust X-Forwarded-* headers from (comma-separated IPs/CIDRs, or *)
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Recommended stack: Reverb for realtime updates. Set BROADCAST_CONNECTION=reverb,
# uncomment these, and rebuild the frontend (the VITE_ values are read at build time).
# REVERB_APP_ID=nagare
# REVERB_APP_KEY=nagare-local-key
# REVERB_APP_SECRET=nagare-local-secret
# REVERB_HOST="localhost"
# REVERB_PORT=8080
# REVERB_SCHEME=http

# Optional: where the server publishes events to Reverb, if different from the
# public host above (e.g. an internal Docker service name)
# REVERB_PUBLISH_HOST=reverb
# REVERB_PUBLISH_PORT=8000
# REVERB_PUBLISH_SCHEME=http

# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_APP_NAME="${APP_NAME}"
